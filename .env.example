# Ollama: use Gemma 4 26B A4B as the default creative model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT=600
OLLAMA_STAGE_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
# Unload once after all LLM stages, before ComfyUI uses the GPU.
OLLAMA_UNLOAD_AFTER_GENERATION=true

# ComfyUI portable installation
COMFYUI_AUTO_START=true
COMFYUI_DIR=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=600
# Image checkpoint for the current standard CheckpointLoaderSimple workflow.
# Do not select ACE-Step here; it is an audio-generation checkpoint.
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# Different seeds avoid repeating almost identical compositions across slides.
COMFYUI_SEED_MODE=per_panel

GENERATED_DIR=generated

# Meta credentials remain unused until official Instagram publishing is implemented.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
